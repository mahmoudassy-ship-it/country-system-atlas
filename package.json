{
  "name": "country-system-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "data:atlas": "node scripts/fetch-world-bank.mjs",
    "data:audit": "node scripts/audit-data-quality.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:production:live": "node scripts/verify-production.mjs",
    "data:world-bank": "npm run data:atlas",
    "server:db": "node --disable-warning=ExperimentalWarning scripts/build-server-database.mjs",
    "server:start": "npm run start --prefix server",
    "server:refresh": "node scripts/refresh-server-data.mjs",
    "server:backup": "node scripts/backup-server-data.mjs",
    "data:prune": "node scripts/prune-source-snapshots.mjs",
    "verify:local-api": "node scripts/verify-local-api.mjs",
    "pages:dev": "npm run build && wrangler pages dev",
    "pages:deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@fontsource/newsreader": "^5.2.8",
    "@svg-maps/world": "^2.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
